// Use DBML to define your database structure
// Docs: https://dbml.dbdiagram.io/docs

Table users {
  id integer [primary key]
  email email [not null]
  phone phone
}

Table profiles {
  user_id integer [not null, unique]
  full_name text
  birthday date
  avatar_url text
  facebook_url text
  instagram_url text
}

Table users_lessons {
  id integer [primary key]
  notes text [note: 'User\'s notes for the lesson']
  user_id integer [not null]
  lesson_id integer [not null]
}

Ref users_lessons: users_lessons.user_id ?> users.id // many-to-one
Ref users_lessons: users_lessons.lesson_id ?> lessons.id // many-to-one

Table lessons {
  id integer [primary key]
  title text
}

Table church_lessons {
  id integer [primary key]
  module_id integer [not null]
  lesson_number integer [not null]
  lesson_id integer [not null]

  indexes {
    (module_id, lesson_number) [unique]
  }
}

Table devotion_lessons {
  id integer [primary key]
  odb_link text [not null, unique]
  title text [not null]
  date date [not null, unique]
  lesson_id integer [not null]
}

// Ex. sermonType, DT, LC
Table tracks {
  id integer [primary key, note: 'Track number, 1-indexed']
  name text
}

// Ex. sermon series, DT module, LC week
Table series {
  id integer [primary key]
  name text
  heading text [note: 'Week # or Module #']
  track_id integer [not null]
}

Table lessons_events {
  id integer [primary key]
  lesson_id integer [not null]
  event_id integer [not null]
}

Table lessons_tags {
  id integer [primary key]
  lesson_id integer [not null]
  tags text[] [not null]
}

Table lessons_events_speakers {
  id integer [primary key]
  lessons_events_id integer [not null]
  speaker_id integer [not null]
}

Table lessons_events_slides {
  id integer [primary key]
  lessons_events_id integer [not null]
  slides_link text [not null]
}

Table lessons_completion {
  id integer [primary key]
  lesson_id integer [not null, unique]
  is_completed boolean [not null]
}

Table lessons_events_link {
  id integer [primary key]
  lessons_events_id integer [not null, unique]
  is_live boolean [not null]
}

Table life_group_events {
  id integer [primary key]
  creator_id integer [not null]
  life_group_id integer [not null]
  event_id integer [not null]
}

Table life_groups {
  id integer [primary key]
  name text
}

Table life_group_members {
  id integer [primary key]
  life_group_id integer [not null]
  user_id integer [not null]
  life_group_role_id integer [not null]
  is_admin boolean [not null, note: 'Can edit events']

  indexes {
    (user_id, life_group_id) [unique]
  }
}

Table life_group_roles {
  id integer [primary key]
  name text [not null]
}

Table life_group_events_members {
  id integer [primary key]
  life_group_event_id integer [not null]
  user_id integer [not null]
  event_availability_id integer [not null]

  indexes {
    (user_id, life_group_event_id) [unique]
  }
}

Table events {
  id integer [primary key]
  title text
  datetime datetime [not null]
  location text [not null]
  repeat_every_days integer [not null]
  announcement_end datetime
  note text
}

Table event_availabilities {
  id integer [primary key]
  name text [not null]
}

Table announcements {
  id integer [primary key]
  name text
  category text
  datetime_end datetime
}

Records tracks(id, name) {
  1, 'Consolidation'
  2, 'Life Class'
  3, 'Destiny Training'
}

Records series(id, name, heading, track_id) {
  1, 'Consolidation', null, 1
  2, 'Learning From Our Mistakes', 'Week 1', 2
  11, 'DT Example Title', 'Module 1', 3
}

Records life_group_roles(id, name) {
  1, 'Leader'
  2, 'Co-leader'
}

Records event_availabilities(id, name) {
  1, 'Going'
  2, 'Maybe'
  3, 'Not Going'
}

Ref: "tracks"."id" < "series"."track_id"

Ref: "lessons"."id" <? "lessons_events"."lesson_id"

Ref: "lessons_events"."id" <? "lessons_events_speakers"."lessons_events_id"

Ref: "users"."id" <? "lessons_events_speakers"."speaker_id"

Ref: "lessons_events"."id" <? "lessons_events_slides"."lessons_events_id"

Ref: "lessons"."id" -? "lessons_completion"."lesson_id"

Ref: "lessons"."id" <? "church_lessons"."lesson_id"

Ref: "series"."id" <? "church_lessons"."module_id"

Ref: "lessons"."id" <? "lessons_tags"."lesson_id"

Ref: "lessons"."id" <? "devotion_lessons"."lesson_id"

Ref: "users"."id" <? "life_group_events"."creator_id"

Ref: "users"."id" <? "life_group_members"."user_id"

Ref: "users"."id" <? "life_group_events_members"."user_id"

Ref: "life_groups"."id" <? "life_group_members"."life_group_id"

Ref: "life_group_roles"."id" <? "life_group_members"."life_group_role_id"

Ref: "life_group_events"."id" <? "life_group_events_members"."life_group_event_id"

Ref: "event_availabilities"."id" <? "life_group_events_members"."event_availability_id"

Ref: "events"."id" <? "life_group_events"."event_id"

Ref: "life_groups"."id" <? "life_group_events"."life_group_id"

Ref: "users"."id" -? "profiles"."user_id"

Ref: "lessons_events"."id" -? "lessons_events_link"."lessons_events_id"

Ref: "events"."id" <? "lessons_events"."event_id"